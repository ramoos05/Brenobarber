# Gere uma chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Dev: True | Prod: False
DEBUG=True

# Dev: * | Prod: seudominio.com.br,www.seudominio.com.br (no Render o domínio é adicionado sozinho)
ALLOWED_HOSTS=*

# Banco local (settings/dev.py)
DB_NAME=brenodb
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Produção (settings/prod.py): URL do Postgres
# Exemplo: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=
